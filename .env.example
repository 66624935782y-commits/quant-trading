# 私人密钥不要泄露，不要发给任何人，不要截图或上传本文件。
# API 只启用合约读取/交易权限，禁止提现权限，并绑定自己的静态 IP。
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 必须替换成至少 16 位的独立强密码，不能保留示例。
ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
LIVE_TRADING=false
MAX_DAILY_LOSS_USDT=5
MAX_ORDER_NOTIONAL_USDT=10
DEFAULT_LEVERAGE=5
SESSION_HOURS=8
DATABASE_PATH=runtime/trader.sqlite3
LOG_PATH=runtime/trader.log
